# Smart Package Locker — REST Client requests
#
# Use with the VS Code "REST Client" extension (humao.rest-client).
# Click "Send Request" above each block. Requests that mint tokens or
# create resources are named (# @name ...) so later blocks can reuse
# their responses.
#
# Status: health, auth, stations, lockers, storage rates, register, store, and
# retrieve are all implemented (Levels 1–3). The storage fee in the retrieve
# response is real now — it's 0 only because a static request file picks up the
# package the same day; the tiered per-day rates are exercised in
# test/level3.e2e-spec.ts (which fakes the clock). The rates themselves are
# operator-managed under /storage-rates; migrations/002_seed.sql just ships a
# first version so a fresh deployment can price a stay.
#
# Suggested order: mint tokens → create a station → create lockers → list →
# register → store → retrieve.

@baseUrl = http://localhost:3000

### The station seeded by migrations/002_seed.sql. Not a default — stationId is
### required on POST /lockers and POST /packages/:id/store; this is just one to use.
@seededStation = 00000000-0000-4000-8000-000000000000

###############################################################################
# Health
###############################################################################

### Liveness — process only, never touches MySQL (public)
GET {{baseUrl}}/health/live

### Readiness — SELECT 1; 503 when the DB is unreachable (public)
GET {{baseUrl}}/health/ready

###############################################################################
# Auth — dev tokens (only when AUTH_DEV_TOKENS=true; 404 otherwise)
###############################################################################

### Mint an OPERATOR token
# @name operatorToken
POST {{baseUrl}}/auth/dev-token
Content-Type: application/json

{ "role": "OPERATOR" }

### Mint an AGENT token
# @name agentToken
POST {{baseUrl}}/auth/dev-token
Content-Type: application/json

{ "role": "AGENT" }

### Mint a CUSTOMER token
# `sub` is the customer id the token speaks for — retrieve only opens a locker
# holding a parcel registered against it, so it matches the customerId used in
# the register block below.
# @name customerToken
POST {{baseUrl}}/auth/dev-token
Content-Type: application/json

{ "role": "CUSTOMER", "sub": "11111111-1111-4111-8111-111111111111" }

### Mint a CUSTOMER token for a different customer (for the negative below)
# @name otherCustomerToken
POST {{baseUrl}}/auth/dev-token
Content-Type: application/json

{ "role": "CUSTOMER", "sub": "22222222-2222-4222-8222-222222222222" }

### Tokens captured from the responses above
@operator = {{operatorToken.response.body.token}}
@agent = {{agentToken.response.body.token}}
@customer = {{customerToken.response.body.token}}
@otherCustomer = {{otherCustomerToken.response.body.token}}

###############################################################################
# Stations (role: OPERATOR)
#
# DELETE decommissions rather than erases: lockers (and through them the
# assignment history) reference the station, so the row is kept and hidden.
###############################################################################

### Create a station
# @name createStation
POST {{baseUrl}}/stations
Authorization: Bearer {{operator}}
Content-Type: application/json

{ "name": "North Depota", "location": "Level 2, 14 Rundle St" }

### Station id captured from the response above
@stationId = {{createStation.response.body.id}}

### List active stations
GET {{baseUrl}}/stations
Authorization: Bearer {{operator}}

### List including decommissioned ones
GET {{baseUrl}}/stations?includeDecommissioned=true
Authorization: Bearer {{operator}}

### Read one station
GET {{baseUrl}}/stations/{{stationId}}
Authorization: Bearer {{operator}}

### Rename / relocate it (send only what changes; location: null clears it)
PATCH {{baseUrl}}/stations/{{stationId}}
Authorization: Bearer {{operator}}
Content-Type: application/json

{ "name": "North Hub 2" }

### Decommission it — 409 station_not_empty while it still has live lockers
DELETE {{baseUrl}}/stations/{{stationId}}
Authorization: Bearer {{operator}}

### Negative: unknown station → 404 station_not_found
GET {{baseUrl}}/stations/0a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d
Authorization: Bearer {{operator}}

###############################################################################
# Lockers (role: OPERATOR)
###############################################################################

### Create a SMALL locker
# @name createSmallLocker
POST {{baseUrl}}/lockers
Authorization: Bearer {{operator}}
Content-Type: application/json

{ "code": "A-03", "size": "LARGE", "stationId": "{{seededStation}}" }

### Create a MEDIUM locker
POST {{baseUrl}}/lockers
Authorization: Bearer {{operator}}
Content-Type: application/json

{ "code": "A-02", "size": "MEDIUM", "stationId": "{{seededStation}}" }

### Create a LARGE locker
POST {{baseUrl}}/lockers
Authorization: Bearer {{operator}}
Content-Type: application/json

{ "code": "A-03", "size": "LARGE", "stationId": "{{seededStation}}" }

### Create a locker at an explicit station
POST {{baseUrl}}/lockers
Authorization: Bearer {{operator}}
Content-Type: application/json

{
  "code": "B-01",
  "size": "MEDIUM",
  "stationId": "{{seededStation}}"
}

### List all lockers with availability
# @name listLockers
GET {{baseUrl}}/lockers
Authorization: Bearer {{operator}}

### List including decommissioned lockers
GET {{baseUrl}}/lockers?includeDecommissioned=true
Authorization: Bearer {{operator}}

### List only the lockers at one station
GET {{baseUrl}}/lockers?stationId={{seededStation}}
Authorization: Bearer {{operator}}

### Locker id captured from the create response above
@lockerToManage = {{createSmallLocker.response.body.id}}

### Read one locker with its occupancy and station
GET {{baseUrl}}/lockers/{{lockerToManage}}
Authorization: Bearer {{operator}}

### Relabel it (code and status only — size and station are fixed for life)
PATCH {{baseUrl}}/lockers/{{lockerToManage}}
Authorization: Bearer {{operator}}
Content-Type: application/json

{ "code": "A-01-R" }

### Take it out of service for maintenance (it stops being allocated)
PATCH {{baseUrl}}/lockers/{{lockerToManage}}
Authorization: Bearer {{operator}}
Content-Type: application/json

{ "status": "OUT_OF_SERVICE" }

### Put it back in service
PATCH {{baseUrl}}/lockers/{{lockerToManage}}
Authorization: Bearer {{operator}}
Content-Type: application/json

{ "status": "IN_SERVICE" }

### Decommission it — terminal; 409 locker_occupied if a package is inside
DELETE {{baseUrl}}/lockers/{{lockerToManage}}
Authorization: Bearer {{operator}}

### Negative: create a locker at an unknown station → 404 station_not_found
POST {{baseUrl}}/lockers
Authorization: Bearer {{operator}}
Content-Type: application/json

{
  "code": "Z-01",
  "size": "SMALL",
  "stationId": "0a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d"
}

### Negative: create a locker as AGENT → 403
POST {{baseUrl}}/lockers
Authorization: Bearer {{agent}}
Content-Type: application/json

{ "code": "X-99", "size": "SMALL", "stationId": "{{seededStation}}" }

### Negative: list lockers with no token → 401
GET {{baseUrl}}/lockers

###############################################################################
# Storage rates (role: OPERATOR)
#
# Publish-only: a price change is a NEW version of one size's bands at a future
# effectiveFrom, never an edit — there is no PATCH or DELETE here. The fee is
# recomputed at retrieval from the version effective when the package was
# stored, so editing a published version would rewrite what a customer was
# already charged.
#
# Bands must tile [0, ∞): start at day 0, meet exactly at their edges, and end
# open-ended (toDay null). MySQL can't express that, so the domain enforces it.
###############################################################################

### List every version, newest first (superseded ones included)
GET {{baseUrl}}/storage-rates
Authorization: Bearer {{operator}}

### List one size's history
GET {{baseUrl}}/storage-rates?sizeCode=SMALL
Authorization: Bearer {{operator}}

### Publish next quarter's SMALL prices — first two days free, then 7.50/day
### (edit effectiveFrom to a future date before sending)
POST {{baseUrl}}/storage-rates
Authorization: Bearer {{operator}}
Content-Type: application/json

{
  "sizeCode": "SMALL",
  "effectiveFrom": "2030-03-01T00:00:00.000Z",
  "bands": [
    { "fromDay": 0, "toDay": 2, "rateMinor": 0 },
    { "fromDay": 2, "toDay": null, "rateMinor": 111 }
  ]
}

### Negative: backdating → 422 storage_rate_backdated
POST {{baseUrl}}/storage-rates
Authorization: Bearer {{operator}}
Content-Type: application/json

{
  "sizeCode": "SMALL",
  "effectiveFrom": "2020-01-01T00:00:00.000Z",
  "bands": [{ "fromDay": 0, "toDay": null, "rateMinor": 500 }]
}

### Negative: day 2 priced by no band → 422 invalid_storage_rate_schedule
POST {{baseUrl}}/storage-rates
Authorization: Bearer {{operator}}
Content-Type: application/json

{
  "sizeCode": "MEDIUM",
  "effectiveFrom": "2031-03-01T00:00:00.000Z",
  "bands": [
    { "fromDay": 0, "toDay": 2, "rateMinor": 0 },
    { "fromDay": 3, "toDay": null, "rateMinor": 900 }
  ]
}

### Negative: re-publishing the same size + instant → 409 storage_rate_version_exists
### (send the publish above twice)
POST {{baseUrl}}/storage-rates
Authorization: Bearer {{operator}}
Content-Type: application/json

{
  "sizeCode": "SMALL",
  "effectiveFrom": "2031-03-01T00:00:00.000Z",
  "bands": [{ "fromDay": 0, "toDay": null, "rateMinor": 100 }]
}

### Negative: publish as AGENT → 403
POST {{baseUrl}}/storage-rates
Authorization: Bearer {{agent}}
Content-Type: application/json

{
  "sizeCode": "SMALL",
  "effectiveFrom": "2031-06-01T00:00:00.000Z",
  "bands": [{ "fromDay": 0, "toDay": null, "rateMinor": 100 }]
}

###############################################################################
# Packages — register + store (role: AGENT)
#
# customerId is an opaque reference issued by an upstream customer service — this
# API stores it and never resolves it. Registration is the parcel record; store
# is the physical drop that allocates a locker and mints the pickup code.
###############################################################################

### Register a parcel against a customerId
# @name registerPackage
POST {{baseUrl}}/packages
Authorization: Bearer {{agent}}
Content-Type: application/json

{
  "size": "SMALL",
  "customerId": "11111111-1111-4111-8111-111111111111",
  "trackingRef": "TRK-12345"
}

### Package id captured from the register response
@packageId = {{registerPackage.response.body.packageId}}

### Store it — the smallest fitting locker at that station is chosen
# @name storePackage
POST {{baseUrl}}/packages/{{packageId}}/store
Authorization: Bearer {{agent}}
Content-Type: application/json

{ "stationId": "{{seededStation}}" }

### Values captured from the store response (used by retrieve below)
@lockerId = {{storePackage.response.body.lockerId}}
@pickupCode = {{storePackage.response.body.pickupCode}}

### Register a LARGE parcel
POST {{baseUrl}}/packages
Authorization: Bearer {{agent}}
Content-Type: application/json

{
  "size": "LARGE",
  "customerId": "22222222-2222-4222-8222-222222222222"
}

### Negative: register as CUSTOMER → 403
POST {{baseUrl}}/packages
Authorization: Bearer {{customer}}
Content-Type: application/json

{ "size": "SMALL", "customerId": "11111111-1111-4111-8111-111111111111" }

### Negative: register with no token → 401
POST {{baseUrl}}/packages
Content-Type: application/json

{ "size": "SMALL", "customerId": "11111111-1111-4111-8111-111111111111" }

###############################################################################
# Packages — retrieve (role: CUSTOMER; authorized by locker id + pickup code,
# and only for the customer the parcel was registered against — that comes from
# the token's subject, never the body)
#
# Five wrong codes at one locker and that customer is turned away from it for
# 15 minutes (429, with Retry-After). Only wrong codes count, so the negative
# blocks below do not spend the budget. Sending the wrong-code block six times
# is how you see it; the counter is in Redis under
# retrieval:attempts:<customerId>:<lockerId> and clears on a successful pickup.
###############################################################################

### Negative: another customer with the right code → 404 (retrieval_failed —
### the same answer a wrong code gets). Send this before the block below: once
### the parcel is collected every retrieval 404s and the point is lost.
POST {{baseUrl}}/packages/retrieve
Authorization: Bearer {{otherCustomer}}
Content-Type: application/json

{
  "lockerId": "{{lockerId}}",
  "pickupCode": "{{pickupCode}}"
}

### Retrieve the package stored above
POST {{baseUrl}}/packages/retrieve
Authorization: Bearer {{customer}}
Content-Type: application/json

{
  "lockerId": "{{lockerId}}",
  "pickupCode": "{{pickupCode}}"
}

### Retrieve with explicit values (fill these in by hand)
POST {{baseUrl}}/packages/retrieve
Authorization: Bearer {{customer}}
Content-Type: application/json

{
  "lockerId": "REPLACE_WITH_LOCKER_ID",
  "pickupCode": "000000"
}
