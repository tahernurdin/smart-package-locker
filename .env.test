# E2E environment. Checked in on purpose: it holds no secrets, and it is what
# makes `npm run test:e2e` safe to run against the compose MySQL out of the box.
#
# `test/env.ts` loads this file *before* `.env`, and `process.loadEnvFile` keeps
# the first value it sees, so every variable here wins over `.env` while a real
# shell variable (CI) still wins over both. Only the differences belong here.

# A database of its own. The suites truncate their tables between tests, so this
# must never be the database you develop against.
DATABASE_URL=mysql://root:root@127.0.0.1:3306/locker_test

# Redis DB 1, for the same reason: the limiter suite flushes it between tests,
# and DB 0 is what you develop against.
REDIS_URL=redis://127.0.0.1:6379/1
