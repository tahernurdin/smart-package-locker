# Copy to .env for local (non-Docker) development.

NODE_ENV=development
PORT=3000

# Database — either a single URL...
DATABASE_URL=mysql://root:root@127.0.0.1:3306/locker
# ...or discrete vars (used only when DATABASE_URL is unset):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=root
# DB_NAME=locker

# Redis — backs the retrieval attempt limiter. Required in production; the
# limiter fails open, so a URL left pointing at localhost would switch it off
# in a way nothing else notices.
REDIS_URL=redis://127.0.0.1:6379
# Host port the compose Redis publishes on. Only needed when 6379 is already
# taken on your machine — docker compose reads this from .env.
# REDIS_HOST_PORT=6380

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h
# Mint /auth/dev-token tokens and log one per role on boot. Never enable in prod.
AUTH_DEV_TOKENS=true

# Domain
CURRENCY=AUD
# Optional secret mixed into pickup-code hashes.
PICKUP_CODE_PEPPER=
# Failed pickups allowed at one locker by one customer, then how long that
# customer is turned away from that locker (seconds).
RETRIEVAL_MAX_ATTEMPTS=5
RETRIEVAL_LOCKOUT_SECONDS=900

# How many pickup codes one parcel may be given, and over what window (seconds).
# Each re-issue notifies the customer, so this caps what that costs. The count is
# never cleared — the window restarts on each code issued.
PICKUP_CODE_REISSUE_MAX=3
PICKUP_CODE_REISSUE_WINDOW_SECONDS=3600
